FROM rust:1-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p pharus

FROM debian:bookworm-slim
RUN useradd -r -u 10001 pharus
WORKDIR /app
COPY --from=build /src/target/release/pharus /usr/local/bin/pharus
COPY server/themes /app/themes
VOLUME ["/app/data"]
ENV PHARUS_ADDR=0.0.0.0:8080 \
    PHARUS_DB=/app/data/pharus.db \
    PHARUS_THEMES=/app/themes
EXPOSE 8080
USER pharus
ENTRYPOINT ["pharus", "serve"]
